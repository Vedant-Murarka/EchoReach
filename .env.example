# ==============================================================================
# EchoReach Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite (Zero configuration needed)
DATABASE_URL=sqlite:///./echoreach.db

# For Supabase PostgreSQL (Replace with your actual Supabase credentials):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. LLM Provider API Keys (Gemini / Groq / OpenAI)
# (Note: EchoReach has built-in heuristic fallback, so it works even if left blank!)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free at https://aistudio.google.com)
GEMINI_API_KEY=

# Groq API Key (Ultra-fast Llama 3 - Get free at https://console.groq.com)
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Web Search API Keys (Per-lead live intelligence)
# ------------------------------------------------------------------------------
# Tavily Search API Key (Free tier at https://tavily.com)
TAVILY_API_KEY=

# Serper Google Search API Key (Free tier at https://serper.dev)
SERPER_API_KEY=

# ------------------------------------------------------------------------------
# 4. Guardrails & Safety Configuration
# ------------------------------------------------------------------------------
# Maximum touches allowed to be sent per day across the team
DAILY_SEND_CAP=50

# ------------------------------------------------------------------------------
# 5. Real-Time Webhook Escalation Alerts (Optional)
# ------------------------------------------------------------------------------
# Slack Incoming Webhook URL (e.g. https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# Discord Incoming Webhook URL (e.g. https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. Server Host & Port
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
